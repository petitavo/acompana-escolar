# Copy configuration via scripts/compose.py; it generates secrets outside Git.
APP_MODE=DEMO
COOKIE_SECURE=true
# DEMO and LAB must use independent PostgreSQL databases/volumes.
DATABASE_URL=postgresql+psycopg://acompana:CHANGE_ME@db:5432/acompana
ARTIFACT_DIR=/workspace/.runtime/artifacts
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
LAB_HOST=localhost
RAW_RETENTION_DAYS=7
FEATURE_RETENTION_DAYS=90
EXPORT_TTL_HOURS=24
# Producto: scripts/product.py usa PostgreSQL independiente, sin publicación.
# En un servidor propio: infra/compose.REAL.yaml y secretos en .env.product (ignorado).
PILOT_ENABLED=false
ALLOW_EXTERNAL_NOTIFICATIONS=false
# Opcional; el archivo JSON de cuenta de servicio NO se incorpora al repositorio.
FCM_SERVICE_ACCOUNT=
SCHOOL_HOST=localhost
