FROM python:3.12.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.8.22
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY services/backend services/backend
COPY fixtures fixtures
COPY alembic.ini ./
COPY packages/contracts packages/contracts
RUN useradd --uid 10001 --create-home laboratory && mkdir -p .runtime/artifacts && chown -R laboratory:laboratory .runtime
ENV PATH="/workspace/.venv/bin:$PATH" PYTHONPATH="/workspace/services/backend:/workspace" ARTIFACT_DIR="/workspace/.runtime/artifacts"
USER laboratory
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--no-access-log"]
