# REAL operation env — copy to a PRIVATE file OUTSIDE Git and chmod 600:
#
#   install -m 600 /dev/null ../.runtime/operation.env.REAL
#   # then fill the values below (generate secrets with `openssl rand -base64 32`)
#   docker compose --env-file ../.runtime/operation.env.REAL -f infra/compose.REAL.yaml up -d --wait
#
# Nothing here has an insecure default; unset required values abort the run.
# This file is a TEMPLATE with placeholders only — never commit real secrets.

# --- Database (required) ---------------------------------------------------
POSTGRES_DB=acompana
POSTGRES_USER=acompana
POSTGRES_PASSWORD=            # REQUIRED. openssl rand -base64 32

# --- Retention (required, laboratory limits enforced by app/config.py) -----
RAW_RETENTION_DAYS=7          # 1..30
FEATURE_RETENTION_DAYS=90     # 1..365
EXPORT_TTL_HOURS=24           # 1..24

# --- HTTPS / proxy --------------------------------------------------------
SCHOOL_HOST=escuela.example   # REQUIRED. Review name (Caddyfile.REAL) or real domain (Caddyfile.PUBLIC)
CADDYFILE=Caddyfile.REAL      # Caddyfile.REAL (internal CA) | Caddyfile.PUBLIC (ACME, needs the two below)
SCHOOL_ACME_EMAIL=            # only for Caddyfile.PUBLIC
BIND_ADDRESS=127.0.0.1        # keep loopback for private review
HTTPS_PORT=8444

# --- Product flags -------------------------------------------------------
PILOT_ENABLED=false
ALLOW_EXTERNAL_NOTIFICATIONS=false
FCM_SERVICE_ACCOUNT=          # absolute path to a service-account json, mounted read-only; never baked into an image

# --- Backups (procedure) -----------------------------------------------
# Path to a file holding >=32 random bytes; required for the production backup
# procedure (scripts/product_backup.py --key-file). Keep it on separate media.
BACKUP_KEY_FILE=

# --- Optional generic email notices (no scores or student names) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD_FILE=           # /run/provider-secrets/smtp-password; private host file mode 0600, readable by uid 10001
SCHOOL_PUBLIC_URL=            # https://your-domain with no token/query string
# Put provider files in .runtime/provider-secrets (never source control).
# FCM_SERVICE_ACCOUNT=/run/provider-secrets/fcm.json
# Egress is enabled for the worker by compose.PUBLIC.yaml; never opens worker ports.
